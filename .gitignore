# macOS metadata
.DS_Store

# ffmpeg 2-pass encoding artifacts (produced during video compression)
ffmpeg2pass-*
*.log
*.mbtree

# Raw source uploads (course-code prefixed — CD5_SP26_*, CD5_WEEK*_*,
